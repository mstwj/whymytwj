	private async Task OnChange(UploadFile uploadFile)
	{
		if (uploadFile.GetExtension() != ".xlsx")
		{
			await SwalService.Show(new SwalOption()
			{
				Content = "只支持上传.",
				Category = SwalCategory.Error
			});
			return;
		}

		var stream = new MemoryStream();
		await uploadFile.File!.OpenReadStream().CopyToAsync(stream);
		var users = (await stream.QueryAsync<UserEntity>()).ToList();

		//这里需要验证的，比如 用户名重复乌鸦，密码空呀.. 
		foreach(var user in users)
		{
			//var use = await UserEntity.Select.Where(x => x.UserName == user.UserName).FirstAsync();
			//if (use != null)
			//{
			//提升保持.. 就已经有了这个用户了..
			//}
			//反正就这样搞，这样就可以导入一个表的数据l...
			await user.SaveAsync();
		}

	}

}
