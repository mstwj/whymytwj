@page "/user"
@using BlazorLearWebApp8.Entity
@using MiniExcelLibs

@inject SwalService SwalService
@inject DownloadService DownloadService


@attribute [TabItemOption(Text = "用户管理",Icon="fa-solid fa-suitcase")]


<!--
<Button @onclick="onClick">下载模板</Button>
-->

<ButtonUpload TValue="string" ShowUploadFileList="false" BrowserButtonClass="btn-seconday" onchange="OnChange">上传按钮</ButtonUpload>


<Table IsBordered="true" TItem="UserEntity" IsStriped="true" ShowToolbar="true" ShowExtendButtons="true" ShowExportButton="true" IsPagination="true" PageItemsSource="new []{5,10}">
	<TableColumns>
		<TableColumn @bind-Field="@context.UserName"> </TableColumn>
		<TableColumn @bind-Field="@context.Password"> </TableColumn>
		<TableColumn @bind-Field="@context.NickName"> </TableColumn>
	</TableColumns>

</Table>

