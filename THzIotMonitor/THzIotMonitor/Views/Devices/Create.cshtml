@model THzIotPlatform.Models.Device

@{
    ViewData["Title"] = "新增设备";
    // 从 ViewData 接收设备组列表（用于下拉框）
    var deviceGroups = ViewData["DeviceGroups"] as IEnumerable<THzIotPlatform.Models.DeviceGroup> ?? new List<THzIotPlatform.Models.DeviceGroup>();


    //deviceGroups.Count();
}

<h2>@ViewData["Title"]</h2>

<form action="/Devices/Create" method="post" class="mt-3" style="max-width: 600px;">
    @Html.AntiForgeryToken()

    <!-- 设备名称 -->
    <div class="form-group mb-3">
        <label asp-for="DeviceName" class="form-label">设备名称</label>
        <input type="text" id="DeviceName" name="DeviceName" class="form-control" />
        <span asp-validation-for="DeviceName" class="text-danger"></span>
    </div>

    <!-- 所属设备组（下拉框） -->
    <div class="form-group mb-3">
        <label asp-for="GroupId" class="form-label">所属设备组</label>
        <select id="GroupId" name="GroupId" class="form-select">
            <option value="">-- 请选择设备组 --</option>
            @foreach (var group in deviceGroups)
            {
                <option value="@group.Id">@group.GroupName</option>
            }
        </select>
        <span asp-validation-for="GroupId" class="text-danger"></span>
        
    </div>

    <!-- 设备编码 -->
    <div class="form-group mb-3">
        <label asp-for="DeviceName" class="form-label">设备编码</label>
        <input type="text" id="DeviceCode" name="DeviceCode" class="form-control" />
        <span asp-validation-for="DeviceCode" class="text-danger"></span>
    </div>

    <!-- 设备类型 -->
    <div class="form-group mb-3">
        <label asp-for="DeviceType" class="form-label">设备类型</label>
        <select id="DeviceType" name="DeviceType" class="form-select">
            <option value="电表" @(Model?.DeviceType == "电表" ? "selected" : "")>电表</option>
            <option value="自动补偿控制器" @(Model?.DeviceType == "自动补偿控制器" ? "selected" : "")>自动补偿控制器</option>
        </select>
        <span asp-validation-for="DeviceType" class="text-danger"></span>
    </div>

    <!-- 设备品牌 -->
    <div class="form-group mb-3">
        <label asp-for="Brand" class="form-label">设备品牌</label>
        <input type="text" id="Brand" name="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>

    <!-- 设备型号 -->
    <div class="form-group mb-3">
        <label asp-for="Model" class="form-label">设备型号</label>
        <input type="text" id="Model" name="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <!-- 出厂日期 -->
    <div class="form-group mb-3">
        <label asp-for="ManufactureDate" class="form-label">出厂日期</label>
        <input type="datetime-local" class="form-control" id="ManufactureDate" name="ManufactureDate" />
        <span asp-validation-for="ManufactureDate" class="text-danger"></span>
    </div>

    <!-- 购买日期 -->
    <div class="form-group mb-3">
        <label asp-for="PurchaseDate" class="form-label">购买日期</label>
        <input type="datetime-local" class="form-control" id="PurchaseDate" name="PurchaseDate" />
        <span asp-validation-for="PurchaseDate" class="text-danger"></span>
    </div>

    <!-- 出厂编号 -->
    <div class="form-group mb-3">
        <label asp-for="FactoryNumber" class="form-label">出厂编号</label>
        <input type="text" id="FactoryNumber" name="FactoryNumber" class="form-control" />
        <span asp-validation-for="FactoryNumber" class="text-danger"></span>
    </div>

    <!-- 安装机位 -->
    <div class="form-group mb-3">
        <label asp-for="InstallationLocation" class="form-label">安装机位</label>
        <input type="text" id="InstallationLocation" name="InstallationLocation" class="form-control" />
        <span asp-validation-for="InstallationLocation" class="text-danger"></span>
    </div>

    <!-- 备注 -->
    <div class="form-group mb-3">
        <label asp-for="Remarks" class="form-label">备注</label>
        <textarea id="Remarks" name="Remarks"  class="form-control" rows="3"></textarea>
    </div>

    <!-- 提交按钮 -->
    <button type="submit" class="btn btn-primary">保存</button>
    <a href="/Devices/Index" class="btn btn-outline-secondary ms-2">取消</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}