@model THzIotPlatform.Controllers.ParameterDataViewModel

@{
    ViewData["Title"] = "设备运行数据查询";
}



<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">查询条件</h4>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="startDate" class="form-label">开始时间</label>
                <input type="datetime-local" class="form-control" id="startDate" name="startDate"
                       value="@ViewBag.StartTime" required>
            </div>
            <div class="col-md-4">
                <label for="endDate" class="form-label">结束时间</label>
                <input type="datetime-local" class="form-control" id="endDate" name="endDate"
                       value="@ViewBag.EndTime" required>
            </div>
            <div class="col-md-4">
                <label for="timeGranularity" class="form-label">时间颗粒度</label>
                <select class="form-select" id="timeGranularity" name="timeGranularity">
                    <option value="minute" @(ViewBag.TimeGranularity == "minute" ? "selected" : "")>分钟</option>
                    <option value="hour" @(ViewBag.TimeGranularity == "hour" ? "selected" : "")>小时</option>
                    <option value="day" @(ViewBag.TimeGranularity == "day" ? "selected" : "")>天</option>
                </select>
            </div>

            <div class="col-md-12">
                <label class="form-label">选择设备运行数据</label>
                <div class="input-group">
                    <input type="text" id="selectedParametersText" class="form-control"
                           placeholder="请选择设备参数..." readonly
                           value="@ViewBag.SelectedParametersText">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal"
                            data-bs-target="#parameterSelectModal">
                        选择
                    </button>
                </div>
                <input type="hidden" id="selectedParameters" name="selectedParameters"
                       value="@ViewBag.SelectedParameters">
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">查询</button>
                <button type="button" class="btn btn-secondary" id="resetBtn">重置</button>
            </div>
        </form>
    </div>
</div>

<!-- 数据展示区域 -->
@if (Model != null && Model.GroupedDatas != null && Model.GroupedDatas.Any())
{
    <!-- 图表展示 -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">数据趋势图</h4>
        </div>
        <div class="card-body">
            <canvas id="dataChart" height="100"></canvas>
        </div>
    </div>

    <!-- 统计数据 -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">数据统计</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>设备组-设备-参数名称</th>
                            <th>最大值</th>
                            <th>最小值</th>
                            <th>平均值</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* 直接使用视图模型中已计算好的统计数据 *@
                        @if (Model != null && Model.Statistics != null && Model.Statistics.Any())
                        {
                            foreach (var stat in Model.Statistics)
                            {
                                <tr>
                                    <td>@stat.ParameterFullName</td>
                                    <td>@stat.MaxValue @* 可以在这里添加单位，如：@stat.MaxValue @unit *@</td>
                                    <td>@stat.MinValue</td>
                                    <td>@Math.Round((double)stat.AverageValue, 2)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">没有统计数据</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 详细数据 -->
    @if (Model != null && Model.GroupedDatas != null && Model.GroupedDatas.Any())
    {
        @foreach (var group in Model.GroupedDatas)
        {
            @* group.Key 是 SN，group.Value 是该 SN 对应的所有 ParameterData 列表 *@
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        @* 优先从 ParameterInfo 取名称，否则显示 SN 并提示 *@
                        @if (Model.ParameterInfo != null && Model.ParameterInfo.ContainsKey(group.Key))
                        {
                            @Model.ParameterInfo[group.Key].ParameterName
                        }
                        else if (group.Key != "UNKNOWN_SN")
                        {
                            <span>未知参数 (SN: @group.Key)</span>
                        }
                        else
                        {
                            <span>无效参数 (SN 为空)</span>
                        }
                    </h5>
                </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>设备组</th>
                        <th>设备</th>
                        <th>参数名称</th>
                        <th>数值</th>
                        <th>单位</th>
                        <th>时间</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in group.Value)
                                {
                                    @* 安全处理 item 及 SN 相关逻辑 *@
                                    @if (item != null && !string.IsNullOrEmpty(item.SN))
                                    {

                                        // 安全拆分 SN 获取设备编码
                                        var snParts = item.SN.Split('_');
                                        var deviceCode = snParts.Length > 0 ? snParts[0] : string.Empty;

                                        // 安全获取设备组和设备名称（避免字典为 null 或键不存在）
                                        //var deviceGroupName = "未知设备组";
                                        var groupId = string.Empty; // 或 int? groupId = null;（根据实际类型）
                                        var deviceGroupName = "未知设备组";
                                        var deviceName = "未知设备";

                                        // 3. 先通过deviceCode查询设备信息（含groupid）
                                        if (ViewBag.DeviceMap != null && !string.IsNullOrEmpty(deviceCode))
                                        {
                                            // ViewBag.DeviceMap：存储设备编码→设备信息的映射（在控制器中初始化）
                                            
                                            if (Model.DeviceMap.TryGetValue(deviceCode, out var deviceInfo))
                                            //if (ViewBag.DeviceMap.TryGetValue(deviceCode, out dynamic deviceInfo))
                                            {
                                                // 获取设备名称
                                                deviceName = deviceInfo.DeviceName ?? "未知设备";
                                                // 获取设备所属的groupid（根据实际类型转换，如string或int）
                                                groupId = deviceInfo.GroupId?.ToString() ?? string.Empty;
                                            }
                                        }

                                        // 4. 再通过groupid查询设备组名称
                                        if (ViewBag.DeviceGroupMap != null && !string.IsNullOrEmpty(groupId))
                                        {
                                            // 根据groupId类型调整：若为int则需转换，如 int.TryParse(groupId, out var gId)
                                            if (int.TryParse(groupId, out int groupIdInt))
                                            {
                                                // 2. 用转换后的 int 类型键查询字典
                                                if (ViewBag.DeviceGroupMap != null)
                                                {
                                                    ViewBag.DeviceGroupMap.TryGetValue(groupIdInt, out deviceGroupName);
                                                }
                                            }
                                            else
                                            {
                                                // 转换失败时的默认处理
                                                deviceGroupName = "无效设备组ID";
                                            }
                                        }

                                        

                                        <tr>
                                            <td>@deviceGroupName</td>
                                            <td>@deviceName</td>
                                            <td>@item.ParameterName</td>
                                            <td>@item.Value</td>
                                            <td>@(item.Unit ?? "")</td>
                                            <td>@item.Time.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- 无数据提示 -->
        <div class="alert alert-info">未查询到参数数据</div>
    }
    
}
else if (ViewBag.HasSearched == true)
{
    <div class="alert alert-info">
        没有找到符合条件的数据，请调整查询条件重试。
    </div>
}

<!-- 设备参数选择模态框 -->
<div class="modal fade" id="parameterSelectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">选择设备运行数据</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">设备组</label>
                        <select class="form-select" id="groupIdSelect">
                            <option value="">请选择设备组</option>
                            @if (ViewBag.AllDeviceGroups != null)
                            {
                                foreach (var group in ViewBag.AllDeviceGroups)
                                {
                                    <option value="@group.Id">@group.GroupName</option>
                                }
                            }
                            else
                            {
                                @* 可选：添加默认选项或提示 *@
                                <option value="">未找到设备组数据</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">设备</label>
                        <select class="form-select" id="deviceIdSelect" disabled>
                            <option value="">请先选择设备组</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">设备参数</label>
                        <select class="form-select" id="parameterIdSelect" disabled>
                            <option value="">请先选择设备</option>
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-sm btn-primary" id="addParameterBtn" disabled>
                        <i class="fa fa-plus"></i> 添加
                    </button>
                </div>

                <div class="mt-3">
                    <h6>已选参数</h6>
                    <div id="selectedParametersList" class="list-group">
                        @if (ViewBag.SelectedParameters != null && ((string[])ViewBag.SelectedParameters).Any())
                        {
                            //var parameters = ViewBag.SelectedParameters.Split(',');
                            var selectedParams = ViewBag.SelectedParameters as string[] ?? Array.Empty<string>();
                            foreach (var param in selectedParams)
                            {
                                if (!string.IsNullOrEmpty(param))
                                {
                                    var parts = param.Split('|');
                                    if (parts.Length >= 3) // 根据你的业务逻辑调整（如需要id|名称|设备码则至少3个元素）
                                    {
                                        var paramId = parts[0];
                                        var paramName = parts[1];
                                        var deviceCode = parts[2];

                                        // 正常业务逻辑（如显示已选参数）
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            @paramName
                                            <button type="button" class="btn btn-sm btn-danger remove-parameter" data-id="@paramId">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                    
                                }
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="confirmSelectionBtn">确定</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 设备参数选择相关脚本
        $(document).ready(function() {
            // 设备组选择变化时加载设备
            $('#groupIdSelect').change(function() {
                var groupId = $(this).val();
                if (groupId) {
                    $.get('/Devices/GetDevicesByGroupId?groupId=' + groupId, function(data) {
                        $('#deviceIdSelect').empty().removeAttr('disabled');
                        $('#deviceIdSelect').append('<option value="">请选择设备</option>');
                        $.each(data, function(index, device) {
                            $('#deviceIdSelect').append(
                                '<option value="' + device.deviceCode + '">' + device.deviceName + '</option>'
                            );
                        });
                    });
                } else {
                    $('#deviceIdSelect').empty().append('<option value="">请先选择设备组</option>').attr('disabled', 'disabled');
                    $('#parameterIdSelect').empty().append('<option value="">请先选择设备</option>').attr('disabled', 'disabled');
                    $('#addParameterBtn').attr('disabled', 'disabled');
                }
            });

            // 设备选择变化时加载参数
            $('#deviceIdSelect').change(function() {
                var deviceCode = $(this).val();
                if (deviceCode) {
                    $.get('/DeviceParameters/GetParametersByDeviceCode?deviceCode=' + deviceCode, function(data) {
                        $('#parameterIdSelect').empty().removeAttr('disabled');
                        $('#parameterIdSelect').append('<option value="">请选择参数</option>');
                        $.each(data, function(index, param) {
                            $('#parameterIdSelect').append(
                                '<option value="' + param.id + '">' + param.parameterName + '</option>'
                            );
                        });
                        $('#addParameterBtn').removeAttr('disabled');
                    });
                } else {
                    $('#parameterIdSelect').empty().append('<option value="">请先选择设备</option>').attr('disabled', 'disabled');
                    $('#addParameterBtn').attr('disabled', 'disabled');
                }
            });

            // 添加参数到已选列表
            $('#addParameterBtn').click(function() {
                var paramId = $('#parameterIdSelect').val();
                var paramName = $('#parameterIdSelect option:selected').text();
                var deviceCode = $('#deviceIdSelect').val();
                var deviceName = $('#deviceIdSelect option:selected').text();
                var groupId = $('#groupIdSelect').val();
                var groupName = $('#groupIdSelect option:selected').text();

                if (paramId && !isParameterAlreadySelected(paramId)) {
                    var paramData = paramId + '|' + groupName + '-' + deviceName + '-' + paramName + '|' + deviceCode;
                    var listItem = $('<div class="list-group-item d-flex justify-content-between align-items-center">')
                        .html(paramName +
                              '<button type="button" class="btn btn-sm btn-danger remove-parameter" data-id="' + paramId + '">' +
                              '<i class="fa fa-times"></i></button>')
                        .data('param', paramData);
                    $('#selectedParametersList').append(listItem);
                }
            });

            // 移除已选参数
            $(document).on('click', '.remove-parameter', function() {
                $(this).closest('.list-group-item').remove();
            });

            // 确认选择
            $('#confirmSelectionBtn').click(function() {
                var selectedParameters = [];
                var selectedParametersText = [];

                $('#selectedParametersList .list-group-item').each(function() {
                    selectedParameters.push($(this).data('param'));
                    selectedParametersText.push($(this).contents().first().text().trim());
                });

                $('#selectedParameters').val(selectedParameters.join(','));
                $('#selectedParametersText').val(selectedParametersText.join('; '));
                $('#parameterSelectModal').modal('hide');
            });

            // 检查参数是否已选择
            function isParameterAlreadySelected(paramId) {
                var exists = false;
                $('#selectedParametersList .list-group-item').each(function() {
                    var data = $(this).data('param');
                    if (data && data.startsWith(paramId + '|')) {
                        exists = true;
                        return false;
                    }
                });
                return exists;
            }

            // 重置按钮
            $('#resetBtn').click(function() {
                $('form')[0].reset();
                $('#selectedParameters').val('');
                $('#selectedParametersText').val('');
            });

            @* 引入 Newtonsoft.Json 命名空间 *@
            @using Newtonsoft.Json
            @{
                    // 先检查 Model 是否为 null，避免对 null 调用 GroupBy
                    
                    // 声明变量并初始化默认空集合
                    IEnumerable<string> timeLabels = Enumerable.Empty<string>();

                    // 1. 检查 Model 和 GroupedDatas 不为 null
                    // 2. 从 GroupedDatas 的 Values 中提取所有 ParameterData 列表，再合并为单个集合
                    // 3. 对合并后的集合按 Time 分组、去重、排序
                    if (Model != null && Model.GroupedDatas != null && Model.GroupedDatas.Any())
                    {
                            timeLabels = Model.GroupedDatas.Values // 取所有分组的 ParameterData 列表
                                                                .SelectMany(list => list) // 合并为单个 IEnumerable<ParameterData>
                                                                .Where(item => item != null) // 过滤无效时间
                                                                .GroupBy(item => item.Time) // 按时间分组（注意 Time 可能是可空类型）
                                                                .Select(g => g.Key.ToString("yyyy-MM-dd HH:mm:ss")) // 转换时间格式
                                                                .Distinct() // 去重重复时间
                                                                .OrderBy(d => d); // 按时间排序
                    }

                    // 序列化处理后的集合（确保不会为 null）
                    var labels = @Html.Raw(JsonConvert.SerializeObject(timeLabels));
             }

            // 绘制图表
            @if (Model != null && Model.GroupedDatas != null && Model.GroupedDatas.Any())
            {
                    <text>
                    var ctx = document.getElementById('dataChart').getContext('2d');

                    // 准备图表数据
                    var datasets = [];
                    // 使用后端提前处理好的 timeLabels
                    var labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(timeLabels));

                    @foreach (var group in Model.GroupedDatas)
                    {
                            var sn = group.Key;
                            var paramName = Model.ParameterInfo != null && Model.ParameterInfo.ContainsKey(sn)
                                    ? Model.ParameterInfo[sn].ParameterName
                                    : "未知参数";

                            // 生成随机颜色（仅在后端生成颜色字符串）
                            var random = sn != null ? new Random(sn.GetHashCode()) : new Random();
                            var color = String.Format("#{0:X6}", random.Next(0x1000000));

                            // 序列化分组数据
                            var groupDataJson = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(group.Value));

                            <text>
                            // 处理当前SN的数据点
                            var values = [];
                            labels.forEach(function(label) {
                                var dataPoint = @groupDataJson
                                    .find(d => new Date(d.Time).toString() === new Date(label).toString());
                                values.push(dataPoint ? dataPoint.Value : null);
                            });

                            // 在JavaScript中处理颜色（完全避免Razor类型问题）
                            var colorStr = "@color"; // 直接作为字符串传递
                            var r = parseInt(colorStr.substring(1, 3), 16);
                            var g = parseInt(colorStr.substring(3, 5), 16);
                            var b = parseInt(colorStr.substring(5, 7), 16);

                            datasets.push({
                                label: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(paramName)),
                                data: values,
                                borderColor: colorStr,
                                backgroundColor: 'rgba(' + r + ', ' + g + ', ' + b + ', 0.1)',
                                borderWidth: 2,
                                fill: true,
                                tension: 0.1
                            });
                            </text>
                    }

                    var dataChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: datasets
                        },
                        options: {
                            responsive: true,
                            interaction: {
                                mode: 'index',
                                intersect: false,
                            },
                            scales: {
                                x: {
                                    title: {
                                        display: true,
                                        text: '时间'
                                    }
                                },
                                y: {
                                    title: {
                                        display: true,
                                        text: '数值'
                                    }
                                }
                            }
                        }
                    });
                    </text>
            }

        });
    </script>
}
