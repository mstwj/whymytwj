@model THzIotPlatform.Models.DeviceGroup

@{
    ViewData["Title"] = "删除设备组";
}

<h2>@ViewData["Title"]</h2>

<!-- 警告提示 -->
<div class="alert alert-danger" role="alert">
    确认要删除设备组 <strong>@Model.GroupName</strong> 吗？此操作不可撤销！
    @if (Model.Devices != null && Model.Devices.Any())
    {
        <p class="mt-2">注意：该设备组关联了 @Model.Devices.Count 台设备，删除前请先处理关联设备。</p>
    }
</div>

<!-- 删除表单 -->
<form action="/DeviceGroups/Delete"  method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <input type="hidden" id="Id" name="Id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">确认删除</button>
    <a href="/DeviceGroups/Index" class="btn btn-outline-secondary">取消</a>
</form>