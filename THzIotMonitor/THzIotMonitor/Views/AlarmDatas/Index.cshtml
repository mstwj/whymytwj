@model IEnumerable<THzIotPlatform.Controllers.AlarmDataViewModel>

@{
    ViewData["Title"] = "设备报警数据查询";
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">查询条件</h4>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="startTime" class="form-label">开始时间</label>
                <input type="datetime-local" class="form-control" id="startTime" name="startTime"
                       value="@ViewBag.StartTime" required>
            </div>
            <div class="col-md-4">
                <label for="endTime" class="form-label">结束时间</label>
                <input type="datetime-local" class="form-control" id="endTime" name="endTime"
                       value="@ViewBag.EndTime" required>
            </div>

            <div class="col-md-12">
                <label class="form-label">选择设备</label>
                <div class="input-group">
                    <input type="text" id="selectedDevicesText" class="form-control"
                           placeholder="请选择设备..." readonly
                           value="@ViewBag.SelectedDevicesText">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal"
                            data-bs-target="#deviceSelectModal">
                        选择
                    </button>
                </div>
                <input type="hidden" id="selectedDevices" name="selectedDevices"
                       value="@ViewBag.SelectedDevices">
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">查询</button>
                <button type="button" class="btn btn-secondary" id="resetBtn">重置</button>
            </div>
        </form>
    </div>
</div>

<!-- 数据展示区域 -->
@if (Model != null && Model.Any())
{
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">报警数据列表</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>设备组</th>
                            <th>设备名称</th>
                            <th>报警类型</th>
                            <th>报警时间</th>
                            <th>报警信息</th>
                            <th>值</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.GroupName</td>
                                <td>@item.DeviceName</td>
                                <td>@item.AlarmType</td>
                                <td>@item.AlarmTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@item.AlarmInfo</td>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (ViewBag.HasSearched == true)
{
    <div class="alert alert-info">
        没有找到符合条件的报警数据，请调整查询条件重试。
    </div>
}

<!-- 设备选择模态框 -->
<div class="modal fade" id="deviceSelectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">选择设备</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <select class="form-select" id="deviceMultiSelect" multiple size="10">
                        
                            @foreach (var device in ViewBag.AllDevices)
                            {
                                // 核心：调用 LINQ 静态方法，无需转换集合
                                var isSelected = !string.IsNullOrEmpty(ViewBag.SelectedDevices) &&
                                System.Linq.Enumerable.Contains(ViewBag.SelectedDevices.Split(','), device.DeviceCode);

                                <option value="@device.DeviceCode" @(isSelected ? "selected" : "")>
                                    @device.DeviceNameWithGroup
                                </option>
                            }
                        </select>
                        <small class="form-text text-muted">按住Ctrl键可进行多选</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="confirmDeviceSelectionBtn">确定</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 确认设备选择
            $('#confirmDeviceSelectionBtn').click(function() {
                var selectedDevices = [];
                var selectedDevicesText = [];

                $('#deviceMultiSelect option:selected').each(function() {
                    selectedDevices.push($(this).val());
                    selectedDevicesText.push($(this).text());
                });

                $('#selectedDevices').val(selectedDevices.join(','));
                $('#selectedDevicesText').val(selectedDevicesText.join('; '));
                $('#deviceSelectModal').modal('hide');
            });

            // 重置按钮
            $('#resetBtn').click(function() {
                $('form')[0].reset();
                $('#selectedDevices').val('');
                $('#selectedDevicesText').val('');
            });
        });
    </script>
}
