<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>澳門俾利喇購物廣場（本地测试）电力监控仪表盘</title>

    <!-- 核心依赖 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

    <!-- 辅助依赖 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- Tailwind 配置 -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#165DFF',
                        secondary: '#36CFC9',
                        warning: '#FF7D00',
                        danger: '#F53F3F',
                        success: '#00B42A',
                        dark: '#1D2129',
                        running: '#36D399',
                        stopped: '#3B82F6',
                        error: '#F87272',
                        'light-bg': '#F2F3F5'
                    },
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    boxShadow: {
                        'card': '0 4px 20px rgba(0, 0, 0, 0.08)',
                        'card-hover': '0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)'
                    }
                }
            }
        }
    </script>

    <!-- 自定義工具類 -->
    <style type="text/tailwindcss">
        .content-auto {
            content-visibility: auto;
        }

        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
        }

        .chart-title-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .chart-title {
            font-weight: 600;
            font-size: 1rem;
            color: #1D2129;
        }

        .chart-value {
            font-weight: 700;
            font-size: 1.25rem;
        }

        .chart-average {
            font-size: 0.875rem;
            color: #666;
            display: flex;
            align-items: center;
        }

            .chart-average span {
                margin-left: 0.25rem;
                font-weight: 600;
            }
    </style>

    <!-- 全局樣式 -->
    <style>
        .stat-card {
            background-color: white;
            border-radius: 0.75rem;
            padding: 1.25rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

            .stat-card:hover {
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            }

        .animate-fade-in {
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
        }

            .animate-fade-in.active {
                opacity: 1;
                transform: translateY(0);
            }

        .refresh-indicator {
            position: fixed;
            top: 10px;
            right: 10px;
            padding: 4px 8px;
            background-color: rgba(22, 93, 255, 0.8);
            color: white;
            border-radius: 4px;
            font-size: 12px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

            .refresh-indicator.visible {
                opacity: 1;
            }

        .device-status-card {
            background-color: white;
            border-radius: 0.75rem;
            padding: 1.25rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .device-status-card:hover {
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            }

        .device-status-title {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 1rem;
            color: #1D2129;
            display: flex;
            align-items: center;
        }

        .device-status-icon {
            margin-right: 0.5rem;
            color: #165DFF;
        }

        .circle-bg {
            fill: none;
            stroke: #F2F3F5;
            stroke-width: 8;
        }

        .circle-progress {
            fill: none;
            stroke-width: 8;
            stroke-linecap: round;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
            transition: stroke-dashoffset 0.5s ease;
        }
        /* TRANE设备样式 */
        .trane-card {
            background: linear-gradient(135deg, rgba(22, 93, 255, 0.05) 0%, rgba(54, 207, 201, 0.05) 100%);
            border-radius: 0.75rem;
            border: 1px solid rgba(22, 93, 255, 0.1);
        }

        .trane-status {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-size: 1.5rem;
            font-weight: bold;
            color: #00B42A;
        }

        .status-legend {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .status-item {
            display: flex;
            align-items: center;
            font-size: 0.875rem;
        }

        .status-color {
            width: 0.75rem;
            height: 0.75rem;
            border-radius: 50%;
            margin-right: 0.5rem;
        }

        .bg-device-running {
            background-color: #00B42A;
        }

        .bg-device-stopped {
            background-color: #165DFF;
        }

        .bg-device-fault {
            background-color: #F53F3F;
        }
    </style>

    <script>
        // 頁面加載動畫觸發
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.animate-fade-in').forEach(el => {
                setTimeout(() => el.classList.add('active'), 10);
            });
        });
    </script>
</head>
<body class="bg-light-bg font-inter text-dark min-h-screen">
    <!-- 刷新指示器 -->
    <div id="refresh-indicator" class="refresh-indicator">
        <i class="fa fa-refresh fa-spin mr-1"></i> 正在刷新...
    </div>

    <div class="container mx-auto px-4 py-8">
        <!-- 頁面標題 -->
        <div class="mb-8 animate-fade-in">
            <h1 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold text-dark">澳門俾利喇購物廣場（本地测试）电力监控仪表盘</h1>
            <p class="text-gray-500 mt-2">实时监控和分析电力使用数据 - 每5秒自动刷新</p>
        </div>

        <!-- 加載狀態 -->
        <div id="loading" class="flex justify-center items-center h-64">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-primary"></div>
        </div>

        <!-- 錯誤狀態 -->
        <div id="error" class="hidden bg-danger/10 border border-danger/30 text-danger p-4 rounded-lg mb-6">
            <i class="fa fa-exclamation-circle mr-2"></i>
            <span>数据加载失败，请稍后重试</span>
        </div>

        <!-- 主內容區 -->
        <div id="dashboard-content" class="hidden">
            <!-- 状态概览 -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                <div class="stat-card animate-fade-in">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-gray-500 text-sm">今日用电量 (kWh)</p>
                            <h3 id="today-electricity" class="text-2xl font-bold mt-1">6,286</h3>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                            <i class="fa fa-bolt"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card animate-fade-in" style="animation-delay: 0.1s">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-gray-500 text-sm">本月用电量 (kWh)</p>
                            <h3 id="monthly-electricity" class="text-2xl font-bold mt-1">245,286</h3>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center text-secondary">
                            <i class="fa fa-calendar"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card animate-fade-in" style="animation-delay: 0.2s">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-gray-500 text-sm">实时功率 (kW)</p>
                            <h3 id="active-power" class="text-2xl font-bold mt-1">85.33</h3>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-warning/10 flex items-center justify-center text-warning">
                            <i class="fa fa-tachometer"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 三相電力數據和設備故障 -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <div class="stat-card animate-fade-in">
                    <h3 class="font-bold text-lg mb-4">三相电力参数</h3>
                    <div class="grid grid-cols-3 gap-4">
                        <div id="phase-data-container" class="col-span-3">
                            <!-- 三相数据将通过JS动态填充 -->
                        </div>
                    </div>
                </div>
                <div class="stat-card animate-fade-in" style="animation-delay: 0.3s">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-gray-500 text-sm">总功率因数</p>
                            <h3 id="power-factor" class="text-2xl font-bold mt-1">0.9859</h3>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-success/10 flex items-center justify-center text-success">
                            <i class="fa fa-balance-scale"></i>
                        </div>
                    </div>
                    <div class="flex justify-between items-start mt-6">
                        <div>
                            <p class="text-gray-500 text-sm">环境温度</p>
                            <h3 id="ambient-temperature" class="text-2xl font-bold mt-1">16.8°C</h3>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                            <i class="fa fa-thermometer-half"></i>
                        </div>
                    </div>
                    <div class="flex justify-between items-start mt-6">
                        <div>
                            <p class="text-gray-500 text-sm">总有功功率</p>
                            <h3 id="total-active-power" class="text-2xl font-bold mt-1">458.3 kW</h3>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center text-secondary">
                            <i class="fa fa-bolt"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 設備運行狀態 -->
            <div class="flex flex-col md:flex-row items-center justify-between mb-6 gap-8">
                <div class="flex items-center animate-fade-in">
                    <i class="fa fa-microchip text-blue-500 mr-2 text-xl"></i>
                    <h1 class="text-2xl font-bold text-gray-800">設備運行狀態</h1>
                </div>

                <!-- 環形圖容器 -->
                <div class="relative w-64 h-64 animate-fade-in" style="animation-delay: 0.2s">
                    <!-- Chart.js 底層環形圖 -->
                    <canvas id="statusChart" class="w-full h-full"></canvas>

                    <!-- SVG 進度條（置於上層） -->
                    <svg width="120" height="120" class="absolute top-0 left-0 w-full h-full">
                        <circle class="circle-bg" cx="50%" cy="50%" r="50"></circle>
                        <circle id="device-status-circle" class="circle-progress" cx="50%" cy="50%" r="50" stroke="#36CFC9"></circle>
                    </svg>

                    <!-- 中心計數 -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-4xl font-bold text-gray-800" id="device-total">9</span>
                        <span class="text-gray-500">合計</span>
                    </div>
                </div>

                <!-- 狀態說明 -->
                <div class="space-y-3 animate-fade-in" style="animation-delay: 0.4s">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <span class="status-dot bg-running mr-2"></span>
                            <span class="text-gray-700">運行</span>
                        </div>
                        <span class="font-medium" id="running-count">6</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <span class="status-dot bg-stopped mr-2"></span>
                            <span class="text-gray-700">停機</span>
                        </div>
                        <span class="font-medium" id="stopped-count">2</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <span class="status-dot bg-error mr-2"></span>
                            <span class="text-gray-700">故障</span>
                        </div>
                        <span class="font-medium" id="fault-count">1</span>
                    </div>
                </div>
            </div>

            <!-- TRANE设备数据（替代主要用电项） -->
            <div class="stat-card mb-6 animate-fade-in trane-card relative">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-lg">TRANE 设备监控数据</h3>
                    <div class="text-sm text-gray-500">实时监控</div>
                </div>

                

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        
                        <!-- 设备状态信息 -->
                        <div class="bg-white rounded-lg p-4 shadow-sm">
                            <h4 class="font-semibold mb-2 text-primary">设备状态</h4>
                            <div class="flex items-center mb-2">
                                <span class="status-dot bg-running mr-2"></span>
                                <span id="trane-status-text">正常运行</span>
                            </div>
                            
                        </div>
                    </div>

                    <div>
                        <!-- 设备参数 -->
                        <div class="bg-white rounded-lg p-4 shadow-sm h-full">
                            <h4 class="font-semibold mb-3 text-primary">运行参数</h4>

                            <div class="device-spec">
                                <span class="spec-label">电流</span>
                                <span class="spec-value" id="trane-current">7.3 A</span>
                            </div>

                            <div class="device-spec">
                                <span class="spec-label">电压</span>
                                <span class="spec-value" id="trane-voltage">226.1 V</span>
                            </div>

                            <div class="device-spec">
                                <span class="spec-label">总有功功率</span>
                                <span class="spec-value" id="trane-active-power">2.07 kW</span>
                            </div>

                            <div class="device-spec">
                                <span class="spec-label">总无功功率</span>
                                <span class="spec-value" id="trane-reactive-power">39.7 Kvar</span>
                            </div>

                            <div class="device-spec">
                                <span class="spec-label">总有功电量</span>
                                <span class="spec-value" id="trane-active-energy">680012 kWh</span>
                            </div>                            
                        </div>
                    </div>
                </div>
                </div>
            </div>

            <!-- 新增的两个功率监控图表 -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <!-- 电容有功功率/无功功率图表 -->
                <div class="stat-card animate-fade-in">
                    <div class="chart-title-container">
                        <div>
                            <h3 class="chart-title">電容有功功率/無功功率 (KW/Kvar)</h3>
                            <div class="chart-average">平均 <span id="capacitor-average">53.64</span></div>
                        </div>
                        <div class="text-secondary chart-value" id="capacitor-current">186.6</div>
                    </div>
                    <div class="h-64">
                        <canvas id="capacitor-chart"></canvas>
                    </div>
                </div>

                <!-- 设备有功功率/无功功率图表 -->
                <div class="stat-card animate-fade-in" style="animation-delay: 0.2s">
                    <div class="chart-title-container">
                        <div>
                            <h3 class="chart-title">设备有功功率/無功功率 (KW/Kvar)</h3>
                            <div class="chart-average">平均 <span id="energy-average">22.73</span></div>
                        </div>
                        <div class="text-secondary chart-value" id="energy-current">161.43</div>
                    </div>
                    <div class="h-64">
                        <canvas id="energy-chart"></canvas>
                    </div>
                </div>
            </div>

            <!-- 本周耗电量表格 -->
            <div class="stat-card mb-6 animate-fade-in">
                <div class="chart-title-container">
                    <h3 class="chart-title">本周耗电量明细</h3>
                </div>
                <div class="overflow-x-auto">
                    <table id="fault-table" class="min-w-full divide-y divide-gray-200">
                        <thead>
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">日期</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">耗电量 (kWh)</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">同比变化</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
                            </tr>
                        </thead>
                        <tbody id="fault-table-body" class="divide-y divide-gray-200">
                            <!-- 表格内容将通过JS动态填充 -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 圖表區域 -->
            <div class="grid grid-cols-1 gap-6 mb-8">
                <div class="lg:col-span-2 stat-card animate-fade-in">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="font-bold text-lg">用电量趋势对比</h3>
                        <div class="text-sm text-gray-500">近30天数据</div>
                    </div>
                    <div class="h-80">
                        <canvas id="electricity-chart"></canvas>
                    </div>
                </div>

                <!-- 三相实时电流数据（最近24小时） -->
                <div class="stat-card mb-6 animate-fade-in">
                    <div class="chart-title-container">
                        <h3 class="chart-title">三相实时电流数据（最近24小时）</h3>
                        <div class="flex items-center space-x-4">
                            <div class="flex items-center">
                                <span class="w-3 h-3 rounded-full bg-primary mr-2"></span>
                                <span class="text-sm">L1</span>
                            </div>
                            <div class="flex items-center">
                                <span class="w-3 h-3 rounded-full bg-secondary mr-2"></span>
                                <span class="text-sm">L2</span>
                            </div>
                            <div class="flex items-center">
                                <span class="w-3 h-3 rounded-full bg-warning mr-2"></span>
                                <span class="text-sm">L3</span>
                            </div>
                        </div>
                    </div>
                    <div class="h-80">
                        <canvas id="threePhaseCurrentChart"></canvas>
                    </div>
                </div>

                <!-- 本周耗电量 -->
                <div class="stat-card mb-6 animate-fade-in">
                    <div class="chart-title-container">
                        <h3 class="chart-title">本周耗电量</h3>
                        <div>
                            <span class="chart-value" id="weekly-total">37,893.4 kWh</span>
                            <div class="chart-average">
                                平均每日: <span id="daily-average">5,413.3 kWh</span>
                            </div>
                        </div>
                    </div>
                    <div class="h-64">
                        <canvas id="weeklyConsumptionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // 全局变量
            let mockData = null;
            let refreshInterval;
            let chartInstances = {};
            const CURRENT_THRESHOLD = 60; // 假设电流阈值为60A
            // TRANE设备初始数据
            const traneData = {
                status: "加载中",
                current: 0,
                voltage: 0,
                totalActivePower: 0,
                totalReactivePower: 0,
                totalActiveEnergy: 0
            };

            // 页面加载完成后初始化
            document.addEventListener('DOMContentLoaded', function() {
                loadData();
                refreshInterval = setInterval(loadData, 5000);
            });

            // 加载数据
            async function loadData() {
                const refreshIndicator = document.getElementById('refresh-indicator');
                refreshIndicator.classList.add('visible');

                try {
                    // 模拟数据
                    const data = await getMockData();
                    mockData = data;

                    // 更新页面状态
                    document.getElementById('loading').classList.add('hidden');
                    document.getElementById('dashboard-content').classList.remove('hidden');
                    document.getElementById('error').classList.add('hidden');


                    // 更新仪表盘数据
                    updateDashboard(data);
                    // 更新TRANE设备数据
                    updateTraneData();
                } catch (error) {
                    console.error('数据加载失败:', error);
                    document.getElementById('loading').classList.add('hidden');
                    document.getElementById('dashboard-content').classList.add('hidden');
                    document.getElementById('error').classList.remove('hidden');
                } finally {
                    setTimeout(() => {
                        refreshIndicator.classList.remove('visible');
                    }, 500);
                }
            }

            // 更新仪表盘
            function updateDashboard(data) {
                populateOverviewData(data);
                updateDeviceStatus(data.deviceStatus);
                populatePhaseData(data.phaseDatas);
                // 将故障数据替换为本周耗电量数据
                populateWeeklyConsumption(data.weeklyConsumptionData);
                updateCharts(data);

                // 更新功率图表数据
                updatePowerCharts(data.powerData);

                // 新增：更新本周耗电量柱状图
                updateWeeklyConsumptionChart(data.weeklyConsumptionData);

                // 新增：更新三相电流图表
                updateThreePhaseCurrentChart(data.threePhaseCurrentData);
            }

            // 更新TRANE设备数据
        async function updateTraneData() {
                try {
                    // 调用后台API获取TRANE设备数据
                    const response = await fetch('/Dashboard/GetElectricitySummary', {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json; charset=utf-8',
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`API请求失败: ${response.status}`);
                    }

                    // 解析API返回的数据
                    const apiData1 = await response.json();

                    // 更新traneData对象
                    traneData.status = apiData1.status || "未知";
                    traneData.current = parseFloat(apiData1.tuaneCurrent) || 0;
                    traneData.voltage = parseFloat(apiData1.tuaneVoltage) || 0;
                    traneData.totalActivePower = parseFloat(apiData1.tuaneTotalActivePower) || 0;
                    traneData.totalReactivePower = parseFloat(apiData1.tuaneTotalReactivePower) || 0;
