            // 填充本周耗电量数据（替换故障记录）
            function populateWeeklyConsumption(weeklyData) {
              const tableBody = document.getElementById('fault-table-body');
              tableBody.innerHTML = '';

              // 确保表格标题正确
              const tableHeader = document.querySelector('#fault-table thead tr');
              if (tableHeader) {
                tableHeader.innerHTML = `
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">星期</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">耗电量 (kWh)</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">同比变化</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
                `;
              }

              // 处理数据为空的情况
              if (!weeklyData || !weeklyData.days || !weeklyData.values || weeklyData.days.length !== weeklyData.values.length) {
                tableBody.innerHTML = `
                  <tr>
                    <td colspan="4" class="px-4 py-8 text-center text-gray-500">
                      暂无耗电量记录
                    </td>
                  </tr>
                `;
                return;
              }

              // 遍历数据并创建表格行
              weeklyData.days.forEach((day, index) => {
                const consumption = weeklyData.values[index];

                // 这里可以根据实际业务逻辑计算同比变化
                // 这里使用随机值作为示例，实际应根据真实数据计算
                const changeValue = (Math.random() * 10 - 5).toFixed(1); // -5% 到 5% 之间的随机值,同比变化率 = [(当前周期数值 - 去年同期数值) / 去年同期数值] × 100%

                // 计算同比变化样式
                let changeClass = 'text-gray-500';
                let changeIcon = '';

                if (parseFloat(changeValue) > 0) {
                  changeClass = 'text-green-500';
                  changeIcon = '↑';
                } else if (parseFloat(changeValue) < 0) {
                  changeClass = 'text-red-500';
                  changeIcon = '↓';
                }

                // 简单的状态判断逻辑（可根据实际需求调整）
                const isAbnormal = consumption > 7000 || consumption < 5000;
                const statusClass = isAbnormal ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800';
                const statusText = isAbnormal ? '异常' : '正常';

                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 transition-colors';
                row.innerHTML = `
                  <td class="px-4 py-3 whitespace-nowrap text-sm">
                    ${day}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-sm font-medium">
                    ${consumption.toFixed(2)}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-sm ${changeClass}">
                    ${changeIcon} ${Math.abs(changeValue)}%
                  </td>
                  <td class="px-4 py-3 text-sm">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${statusClass}">
                      ${statusText}
                    </span>
                  </td>
                `;
                tableBody.appendChild(row);
              });
            }

