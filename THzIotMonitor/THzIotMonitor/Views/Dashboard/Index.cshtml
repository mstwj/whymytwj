                            x: { grid: { display: false } }
                        },
                        animation: { duration: 1000, easing: 'easeOutQuart' }
                    }
                });
            }

            // 新增：更新本周耗电量柱状图
            function updateWeeklyConsumptionChart(weeklyData) {
                // 检查数据是否有效
                if (!weeklyData || !weeklyData.days || !weeklyData.values) {
                    console.error('无效的本周耗电量数据');
                    return;
                }

                // 计算总计和平均值
                const total = weeklyData.values.reduce((sum, value) => sum + value, 0);
                const average = total / weeklyData.values.length;

                // 更新总计和平均值显示
                document.getElementById('weekly-total').textContent = `${total.toFixed(1)} kWh`;
                document.getElementById('daily-average').textContent = `${average.toFixed(1)} kWh`;

                // 销毁旧图表
                if (chartInstances.weeklyConsumption) {
                    chartInstances.weeklyConsumption.destroy();
                    chartInstances.weeklyConsumption = null;
                }

                // 创建新图表
                chartInstances.weeklyConsumption = drawWeeklyConsumptionChart(weeklyData);
            }

                        // 更新三相实时电流图表 - 修复键名大小写问题
            function updateThreePhaseCurrentChart(data) {
                // 增强数据验证，确保所有必要属性都存在
                if (!data || !data.timestamps || !data.phases ||
                    !Array.isArray(data.timestamps) || typeof data.phases !== 'object') {
                    console.error('无效的三相电流数据结构:', data);
                    return;
                }

                // 为每个相数据提供默认值，注意使用小写l1、l2、l3以匹配数据
                const l1Data = Array.isArray(data.phases.l1) ? data.phases.l1 : [];
                const l2Data = Array.isArray(data.phases.l2) ? data.phases.l2 : [];
                const l3Data = Array.isArray(data.phases.l3) ? data.phases.l3 : [];

                // 检查是否有电流超过阈值
                const l1Over = l1Data.some(value => typeof value === 'number' && value > CURRENT_THRESHOLD);
                const l2Over = l2Data.some(value => typeof value === 'number' && value > CURRENT_THRESHOLD);
                const l3Over = l3Data.some(value => typeof value === 'number' && value > CURRENT_THRESHOLD);

                // 更新警报显示
                const alertElement = document.getElementById('current-alert');
                if (alertElement) {
                    const alertMessage = alertElement.querySelector('#alert-message') || alertElement;

                    if (l1Over || l2Over || l3Over) {
                        let message = '电流超过阈值: ';
                        if (l1Over) message += 'L1相, ';
                        if (l2Over) message += 'L2相, ';
                        if (l3Over) message += 'L3相, ';

                        // 移除最后的逗号和空格
                        message = message.slice(0, -2);
                        alertMessage.textContent = message;
                        alertElement.classList.add('visible');
                    } else {
                        alertElement.classList.remove('visible');
                    }
                }

                // 销毁旧图表（如果存在）
                if (chartInstances.threePhaseCurrent) {
                    chartInstances.threePhaseCurrent.destroy();
                }

                // 创建新图表 - 使用处理后的数据
                chartInstances.threePhaseCurrent = drawThreePhaseCurrentChart({
                    ...data,
                    phases: {
                        l1: l1Data,  // 保持小写以匹配数据
                        l2: l2Data,
                        l3: l3Data
                    }
                });
            }

            // 绘制三相实时电流图表（最近24小时）- 修复版
            function drawThreePhaseCurrentChart(data) {
                // 再次验证数据，确保安全
                if (!data || !data.timestamps || !data.phases ||
                    !Array.isArray(data.timestamps) || !Array.isArray(data.phases.l1) ||
                    !Array.isArray(data.phases.l2) || !Array.isArray(data.phases.l3)) {
                    console.error('无效的三相电流数据:', data);
                    return null;
                }

                // 确保canvas元素存在
                const canvas = document.getElementById('threePhaseCurrentChart');
                if (!canvas) {
                    console.error('未找到ID为threePhaseCurrentChart的canvas元素');
                    return null;
                }

                const ctx = canvas.getContext('2d');
                if (!ctx) {
                    console.error('无法获取canvas上下文');
                    return null;
                }

                // 创建渐变填充
                const l1Gradient = ctx.createLinearGradient(0, 0, 0, 300);
                l1Gradient.addColorStop(0, 'rgba(22, 93, 255, 0.2)');
                l1Gradient.addColorStop(1, 'rgba(22, 93, 255, 0)');

                const l2Gradient = ctx.createLinearGradient(0, 0, 0, 300);
                l2Gradient.addColorStop(0, 'rgba(54, 207, 201, 0.2)');
                l2Gradient.addColorStop(1, 'rgba(54, 207, 201, 0)');

                const l3Gradient = ctx.createLinearGradient(0, 0, 0, 300);
                l3Gradient.addColorStop(0, 'rgba(245, 63, 63, 0.2)');
                l3Gradient.addColorStop(1, 'rgba(245, 63, 63, 0)');

                // 确保阈值常量已定义
                const CURRENT_THRESHOLD = window.CURRENTThreshold || 130;

                // 计算Y轴的合理范围，避免空数据导致的错误
                const allValues = [...data.phases.l1, ...data.phases.l2, ...data.phases.l3].filter(v => typeof v === 'number');
                const minValue = allValues.length > 0 ? Math.min(...allValues) * 0.9 : 0;
                const maxValue = allValues.length > 0 ? Math.max(...allValues) * 1.1 : CURRENT_THRESHOLD * 1.2;

                return new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.timestamps || [],
                        datasets: [
                            {
                                label: 'L1 电流 (A)',
                                data: data.phases.l1 || [],  // 使用小写l1
                                borderColor: '#165DFF',
                                backgroundColor: l1Gradient,
                                tension: 0.4,
                                fill: true,
                                borderWidth: 2,
                                pointBackgroundColor: '#165DFF',
                                pointRadius: 2,
                                pointHoverRadius: 5
                            },
                            {
                                label: 'L2 电流 (A)',
                                data: data.phases.l2 || [],  // 使用小写l2
                                borderColor: '#36CFC9',
                                backgroundColor: l2Gradient,
                                tension: 0.4,
                                fill: true,
                                borderWidth: 2,
                                pointBackgroundColor: '#36CFC9',
                                pointRadius: 2,
                                pointHoverRadius: 5
                            },
                            {
                                label: 'L3 电流 (A)',
                                data: data.phases.l3 || [],  // 使用小写l3
                                borderColor: '#F53F3F',
                                backgroundColor: l3Gradient,
                                tension: 0.4,
                                fill: true,
                                borderWidth: 2,
                                pointBackgroundColor: '#F53F3F',
                                pointRadius: 2,
                                pointHoverRadius: 5
                            },
                            {
                                // 阈值参考线
                                label: '阈值 (A)',
                                data: data.timestamps.map(() => CURRENT_THRESHOLD),
                                borderColor: 'rgba(255, 125, 0, 0.7)',
                                borderWidth: 2,
                                borderDash: [5, 5],
                                fill: false,
                                tension: 0,
                                pointRadius: 0
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: 12,
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(29, 33, 41, 0.8)',
                                padding: 10,
                                callbacks: {
                                    label: function(context) {
                                        const dataset = context.dataset || {};
                                        const label = dataset.label || '';
                                        const value = context.raw || 0;
                                        return `${label}: ${value.toFixed(2)}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                min: minValue,
                                max: maxValue,
                                grid: { color: 'rgba(0, 0, 0, 0.05)' },
                                title: {
                                    display: true,
                                    text: '电流 (A)'
                                }
                            },
                            x: {
                                grid: { display: false },
                                ticks: {
                                    maxRotation: 0,
                                    autoSkip: true,
                                    maxTicksLimit: 8
                                }
                            }
                        },
                        animation: {
                            duration: 1000,
                            easing: 'easeOutQuart'
                        }
                    }
                });
            }





                                    // 新增：绘制本周耗电量柱状图
            function drawWeeklyConsumptionChart(data) {
                const ctx = document.getElementById('weeklyConsumptionChart').getContext('2d');

                // 为每个柱子生成颜色，高于平均值的用不同颜色
                const average = data.values.reduce((sum, value) => sum + value, 0) / data.values.length;
                const backgroundColors = data.values.map(value =>
                    value > average ? 'rgba(22, 93, 255, 0.7)' : 'rgba(54, 207, 201, 0.7)'
                );

                return new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.days || [],
                        datasets: [{
                            label: '耗电量 (kWh)',
                            data: data.values || [],
                            backgroundColor: backgroundColors,
                            borderColor: data.values.map(value =>
                                value > average ? 'rgba(22, 93, 255, 1)' : 'rgba(54, 207, 201, 1)'
                            ),
                            borderWidth: 1,
                            borderRadius: 4,
                            barPercentage: 0.6,
                            categoryPercentage: 0.8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(29, 33, 41, 0.8)',
                                padding: 10,
                                callbacks: {
                                    label: function(context) {
                                        return `耗电量: ${context.raw.toFixed(2)} kWh`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(0, 0, 0, 0.05)' },
                                ticks: {
                                    callback: function(value) {
                                        return value + ' kWh';
                                    }
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        },
                        animation: { duration: 1000, easing: 'easeOutQuart' }
                    }
                });
            }

            
        </script>

</body>
</html>
