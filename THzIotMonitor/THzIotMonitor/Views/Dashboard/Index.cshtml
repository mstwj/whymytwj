            // 更新设备运行状态
            function updateDeviceStatus(status) {
                const runningCountEl = document.getElementById('running-count');
                const stoppedCountEl = document.getElementById('stopped-count');
                const faultCountEl = document.getElementById('fault-count');
                const deviceTotalEl = document.getElementById('device-total');
                const deviceStatusCircleEl = document.getElementById('device-status-circle');

                if (!runningCountEl || !stoppedCountEl || !faultCountEl || !deviceTotalEl || !deviceStatusCircleEl) {
                    console.error('设备状态元素不存在');
                    return;
                }

                // 更新计数器
                runningCountEl.textContent = status.running;
                stoppedCountEl.textContent = status.stopped;
                faultCountEl.textContent = status.fault;

                // 计算总数和百分比
                const total = status.running + status.stopped + status.fault;
                deviceTotalEl.textContent = total;

                // 计算SVG进度条
                const circumference = 2 * Math.PI * 50; // 圆周长
                const runningPercentage = total > 0 ? (status.running / total) : 0;
                const offset = circumference - (runningPercentage * circumference);

                // 应用样式
                deviceStatusCircleEl.style.strokeDasharray = circumference;
                deviceStatusCircleEl.style.strokeDashoffset = offset;

                // 状态颜色切换
                if (status.fault > 0) {
                    deviceStatusCircleEl.setAttribute('stroke', '#F53F3F');
                } else if (status.running === 0 && total > 0) {
                    deviceStatusCircleEl.setAttribute('stroke', '#165DFF');
                } else {
                    deviceStatusCircleEl.setAttribute('stroke', '#36CFC9');
                }
            }

