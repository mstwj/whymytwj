@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace Blazor7server.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="Blazor7server.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    <!--下面这一段，你可以理解为占位符..反正底层是很复杂的，你只要知道，你写一个TILTE，这里就会换掉了，就OK了..-->
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <!--下面这一段，你可以理解为占位符..反正底层是很复杂的就OK了..
        这就是第一个文件，反正这些东西，都可以不要动... 主要看着个APP..
        这个APP就对应什么呢?就对应了APP.RAZOR这个文件..
        componet 不是组件，就是一个标签，类似BUTTON呀，什么的..
    -->
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <!--下面这一段你可以不要管....-->
    <script src="_framework/blazor.server.js"></script>
    <!--... ./Pages注意大小写，LIUNX必须一样的...-->
	<script src="./Pages/Jstest.razor.js"></script>

</body>
</html>
