@page "/foo1"
@inject IJSRuntime Runtime

<CascadingValue Value="Foos" IsFixed="true">
	
	<Blazor7server.Compnments.Foo2Component></Blazor7server.Compnments.Foo2Component>
	<Blazor7server.Compnments.Foo3Component></Blazor7server.Compnments.Foo3Component>
</CascadingValue>


<Blazor7server.Compnments.RenderTemplate>
	@foreach(var i in Foos)
	{
		<div>Comp @i</div>
	}
</Blazor7server.Compnments.RenderTemplate>

