
<div>@ValueString</div>

@if(Items != null)
{
	foreach(var item in Items)
	{
		<div>@item</div>
	}
}


@code {
	private string? ValueString{ get; set; }


	[CascadingParameter]
	private List<string?> Items { get; set; }

