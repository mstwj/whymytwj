@inherits LayoutComponentBase

<BootstrapBlazorRoot>
	<Layout
		ShowGotoTop="true"
		ShowCollapseBar="true"
		ShowFooter="@ShowFooter"
		SideWidth="0"
		IsPage="true"
		IsFullSide="@IsFullSide"
		IsFixedHeader="@IsFixedHeader"
		IsFixedFooter="@IsFixedFooter"
		ShowSplitBar="true"
		SidebarMinWidth="200"
		SidebarMaxWidth="350"
		TabStyle="TabStyle.Chrome"
		ShowToolbar="true"
		ShowTabContextMenu="true"
        ShowTabInHeader="@ShowTabInHeader"
		ShowTabExtendButtons="false"
		TabDefaultUrl="/"
		UseTabSet="@UseTabSet"
		IsFixedTabHeader="IsFixedTabHeader"
        AdditionalAssemblies="new[] { GetType().Assembly }"
        Menus="@Menus"
		class="@Theme">
        <Header></Header>
        <Side>
            <div class="layout-banner">
                <img class="layout-logo" src="../images/logo.png" />
                <div class="layout-title">
                    <span>公司名称</span>
                </div>
            </div>
        </Side>
        <Main>
			<!--用CascadingValue实现组件之间数据访问 IsFixed="true" 不下传递..
				处 Value="this" 表示父组件将自身实例传递给子组件
			-->
			<CascadingValue Value="this" IsFixed="true">
				@Body
            </CascadingValue>
        </Main>
        <Footer>
            <div class="text-center flex-fill">
                <a class="page-layout-demo-footer-link" href="https://pro.blazor.zone/" target="_blank">Bootstrap Admin</a>
            </div>
        </Footer>
    </Layout>

   
</BootstrapBlazorRoot>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
