            <TextBox Grid.Row="14" IsReadOnly="True" Text="{Binding ShowCdianliu}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />


            <TextBlock Grid.Row="15" TextWrapping="Wrap" Text="A相功率因数：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="15" IsReadOnly="True" Text="{Binding ShowAglys}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="16" TextWrapping="Wrap" Text="B相功率因数：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="16" IsReadOnly="True" Text="{Binding ShowBglys}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="17" TextWrapping="Wrap" Text="C相功率因数：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="17" IsReadOnly="True" Text="{Binding ShowCglys}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="18" TextWrapping="Wrap" Text="需要投入电容(10KVAR)：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="18" IsReadOnly="True" Text="{Binding ShowTrdn}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

        </Grid>

        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
