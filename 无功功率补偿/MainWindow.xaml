<Window x:Class="无功功率补偿.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:无功功率补偿"
        mc:Ignorable="d"
        Title="无功功率补偿" Height="750" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="A相电压 " VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="0"  Text="{Binding Adianya}" Height="20"  VerticalAlignment="Center" Width="100"  HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="1" Text="B相电压" VerticalAlignment="Center"  Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="1"  Text="{Binding Bdianya}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="2" Text="C相电压" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="2"  Text="{Binding Cdianya}" Height="20"   VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />


            <TextBlock Grid.Row="3" Text="A相电流 " VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="3"  Text="{Binding Adianliu}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="4" Text="B相电流" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="4"  Text="{Binding Bdianliu}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="5" Text="C相电流" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="5"  Text="{Binding Cdianliu}" Height="20"   VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="6" Text="功率因数" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="6"  Text="{Binding Oldfactor}" Height="20"   VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />



            <Button Grid.Row="7" Command="{Binding BtnCommandStart3}" Visibility="Hidden" Content="点击计算2"></Button>

            <Button Grid.Row="7" Command="{Binding BtnCommandStart2}"  Content="开始"></Button>

            <Button Grid.Row="8" Command="{Binding BtnCommandStartStop}"  Content="停止"></Button>

        </Grid>


        <Grid Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>

            </Grid.RowDefinitions>




            <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="A相视在功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="0" IsReadOnly="True" Text="{Binding ShowASzgl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="1" TextWrapping="Wrap" Text="B相视在功率：" VerticalAlignment="Center" Margin="20 0 0 0"> </TextBlock>
            <TextBox Grid.Row="1" IsReadOnly="True" Text="{Binding ShowBSzgl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="2" TextWrapping="Wrap" Text="C相视在功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="2" IsReadOnly="True" Text="{Binding ShowCSzgl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />


            <TextBlock Grid.Row="3" TextWrapping="Wrap" Text="A相有功功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="3" IsReadOnly="True" Text="{Binding ShowAyggl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="4" TextWrapping="Wrap" Text="B相有功功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="4" IsReadOnly="True" Text="{Binding ShowByggl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="5" TextWrapping="Wrap" Text="C相有功功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="5" IsReadOnly="True" Text="{Binding ShowCyggl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="6" TextWrapping="Wrap" Text="A相无功功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="6" IsReadOnly="True" Text="{Binding ShowAwggl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="7" TextWrapping="Wrap" Text="B相无功功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="7" IsReadOnly="True" Text="{Binding ShowBwggl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="8" TextWrapping="Wrap" Text="C相无功功率：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="8" IsReadOnly="True" Text="{Binding ShowCwggl}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="9" TextWrapping="Wrap" Text="A相电压 ：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="9" IsReadOnly="True" Text="{Binding ShowAdianya}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

