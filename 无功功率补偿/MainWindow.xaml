            <TextBox Grid.Row="8" IsReadOnly="True" Text="{Binding ShowTPF1}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="9" TextWrapping="Wrap" Text="(燃煤-B有功)碳排放结算值2：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="9" IsReadOnly="True" Text="{Binding ShowTPF2}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="10" TextWrapping="Wrap" Text="(燃煤-C有功)碳排放结算值3：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="10" IsReadOnly="True" Text="{Binding ShowTPF3}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

