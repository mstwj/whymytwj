            <TextBlock Grid.Row="15" TextWrapping="Wrap" Text="(光伏-B有功)碳排放结算值8：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="15" IsReadOnly="True" Text="{Binding ShowTPF8}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

            <TextBlock Grid.Row="16" TextWrapping="Wrap" Text="(光伏-C有功)碳排放结算值9：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="16" IsReadOnly="True" Text="{Binding ShowTPF9}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />


            <TextBlock Grid.Row="17" TextWrapping="Wrap" Text="(水力-A有功)碳排放结算值10：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="17" IsReadOnly="True" Text="{Binding ShowTPF10}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />

