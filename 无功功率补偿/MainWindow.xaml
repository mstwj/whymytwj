            <TextBlock Grid.Row="13" TextWrapping="Wrap" Text="(风电-C有功)碳排放结算值6：" VerticalAlignment="Center" Margin="20 0 0 0"></TextBlock>
            <TextBox Grid.Row="13" IsReadOnly="True" Text="{Binding ShowTPF6}" Height="20"  VerticalAlignment="Center" Width="100" HorizontalAlignment="Right" Margin="0 0 20 0" />


