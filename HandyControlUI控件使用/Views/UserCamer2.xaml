<UserControl x:Class="HandyControlUI控件使用.Views.UserCamer2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HandyControlUI控件使用.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>

        </Grid.RowDefinitions>
        <hc:Badge Grid.Row="0"  Width="100" Height="50"  Style="{StaticResource BadgeDanger}"
                   Text="提交" Value="3">
            <TextBlock Text="已经提i骄傲" Style="{StaticResource TextBlockDefaultInfo}"></TextBlock>
        </hc:Badge>

        <hc:TextBox Grid.Row="1" Text="Admin" Width="200" 
                    Height="60" hc:TitleElement.Title="用户名称" 
                    hc:InfoElement.Necessary="True" hc:InfoElement.Symbol="*"
                    TextType="Int" ErrorStr="只能输入数字" IsError="True"></hc:TextBox>


    </Grid>
</UserControl>
