<UserControl x:Class="HandyControlUI控件使用.Views.UseCamera1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HandyControlUI控件使用.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Text="电流表"></TextBlock>
        <TextBlock Text="AAAA:"></TextBlock>
        <TextBlock Text="{Binding AAAA}"></TextBlock>
        <TextBlock Text="BBBB:"></TextBlock>
        <TextBlock Text="{Binding BBBB}"></TextBlock>

        <!--表示一行..-->
        <UniformGrid Rows="1" Grid.Row="1" >
            <StackPanel>
            <TextBlock Text="监控" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <local:MyCircleTest Value="20.2" Height="200" Width="200"></local:MyCircleTest>
            </StackPanel>
        </UniformGrid>

        <Button Content="按钮 -- 生成1个线程" Command="{Binding BtnCommandSendHandJSOK}"></Button>
        <TextBlock Text="{Binding MYTEST}"></TextBlock>

        <Button Content="按钮 -- 取消1个线程" Command="{Binding BtnCommandSendHandJSCansel}"></Button>


    </StackPanel>
</UserControl>
